{
  "manifest_version": 2,
  "browser_specific_settings": { "gecko": { "id": "playlist@myfirefox.org" } },
  "name": "MyFirefox playlist reader",
  "version": "1.0",
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.soundcloud.com/*"],
      "js": ["playlist-content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["geckoViewAddons", "nativeMessaging", "nativeMessagingFromContent"]
}
